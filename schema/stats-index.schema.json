{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earthquakes-feed.theshelter.app/schema/stats-index.schema.json",
  "title": "Statistics index (v1/stats/index.json)",
  "description": "The catalog of the statistics files with their sha256: the 61 day tables (today - 60 .. today, or named in missing_days), the year files (current year and the two before) and the area files (1973 .. current year). generated equals the v1 manifest's generated of the same run; the signed v2 manifest names this file's sha256. APIs.md, Statistics.",
  "type": "object",
  "required": ["schema_version", "format", "generated", "generated_iso", "head_seq", "days", "missing_days", "through", "years", "area", "completeness", "attribution"],
  "properties": {
    "schema_version": { "type": "integer" },
    "format": { "const": 1 },
    "generated": { "type": "integer" },
    "generated_iso": { "type": "string", "format": "date-time" },
    "head_seq": { "type": "integer" },
    "days": {
      "type": "array",
      "maxItems": 61,
      "items": {
        "type": "object",
        "required": ["date", "path", "count", "filtered", "bytes", "sha256"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "path": { "type": "string", "pattern": "^v1/stats/days/\\d{4}-\\d{2}-\\d{2}\\.json$" },
          "count": { "type": "integer", "minimum": 0 },
          "filtered": { "type": "integer", "minimum": 0 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "missing_days": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } },
    "through": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "the last day the year and area files cover (the stats builder's ledger); null before its first run" },
    "years": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["year", "path", "bytes", "sha256", "first", "through", "complete", "mirrorable"],
        "properties": {
          "year": { "type": "integer" },
          "path": { "type": "string", "pattern": "^v1/stats/year/\\d{4}\\.json$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "first": { "type": "string" },
          "through": { "type": "string" },
          "complete": { "type": "boolean" },
          "mirrorable": { "const": true }
        }
      }
    },
    "area": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["year", "path", "bytes", "sha256", "min_mag", "records", "m6", "complete", "mirrorable"],
        "properties": {
          "year": { "type": "integer" },
          "path": { "type": "string", "pattern": "^v1/stats/area/\\d{4}\\.json$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "min_mag": { "type": ["number", "null"] },
          "records": { "type": "integer", "minimum": 0 },
          "m6": { "type": "integer", "minimum": 0 },
          "complete": { "type": "boolean" },
          "mirrorable": { "const": true, "description": "the file is byte for byte the data branch file at the same path: jsdelivr-sha and raw-sha serve it too (check its sha256)" }
        }
      }
    },
    "completeness": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "key"],
        "properties": {
          "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "to": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "key": { "type": "string" },
          "min_mag": { "type": "number" }
        }
      }
    },
    "attribution": { "type": "string" }
  }
}
