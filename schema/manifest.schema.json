{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earthquakes-feed.theshelter.app/schema/manifest.schema.json",
  "title": "Feed catalog manifest",
  "type": "object",
  "required": ["schema_version", "generated", "generated_iso", "head_seq", "freshness", "data_repo", "summaries", "partitions"],
  "properties": {
    "schema_version": { "type": "integer" },
    "generated": { "type": "integer", "description": "ms epoch" },
    "generated_iso": { "type": "string", "format": "date-time" },
    "head_seq": { "type": "integer" },
    "event_count": { "type": "integer" },
    "freshness": {
      "type": "object",
      "required": ["expected_interval_seconds", "stale_after_seconds"],
      "properties": {
        "expected_interval_seconds": { "type": "integer" },
        "stale_after_seconds": { "type": "integer" }
      }
    },
    "data_repo": { "type": "string" },
    "jsdelivr_base": { "type": "string" },
    "data_commit": { "type": ["string", "null"], "description": "data-branch commit SHA; build immutable URLs as {jsdelivr}/gh/{repo}@{data_commit}/{path}" },
    "summaries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "count"],
        "properties": {
          "path": { "type": "string" },
          "url": { "type": "string" },
          "count": { "type": "integer" }
        }
      }
    },
    "partitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "path", "count", "frozen"],
        "properties": {
          "date": { "type": "string" },
          "path": { "type": "string" },
          "url": { "type": "string" },
          "pages_url": { "type": "string" },
          "count": { "type": "integer" },
          "bytes": { "type": "integer" },
          "min_mag": { "type": ["number", "null"] },
          "max_mag": { "type": ["number", "null"] },
          "frozen": { "type": "boolean" }
        }
      }
    },
    "archives": { "type": "array", "items": { "type": "object" } },
    "live": {
      "type": "object",
      "description": "The live index (APIs.md, Live index): the week window as per-day files with sha256 fingerprints plus head_seq deltas, for an incremental refresh. Additive (2026-10).",
      "required": ["path", "url", "head_seq", "window_days"],
      "properties": {
        "path": { "type": "string" },
        "url": { "type": "string" },
        "head_seq": { "type": "integer" },
        "window_days": { "type": "integer" }
      }
    },
    "event_detail": {
      "type": "object",
      "description": "Per-hour full-fat detail files (APIs.md, Event detail): put a UTC hour key YYYY-MM-DDTHH into url_template; every hour from first_hour to last_hour has a file. Additive (2026-10).",
      "required": ["path_template", "url_template", "first_hour", "last_hour"],
      "properties": {
        "path_template": { "type": "string" },
        "url_template": { "type": "string" },
        "first_hour": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}$" },
        "last_hour": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{2}$" }
      }
    }
  }
}
