{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earthquakes-feed.theshelter.app/schema/live-index.schema.json",
  "title": "Live index (v1/live/index.json)",
  "description": "The week window as per-day compact files with sha256 fingerprints, plus deltas of every window event above a head_seq bound. APIs.md, Live index.",
  "type": "object",
  "required": ["schema_version", "generated", "generated_iso", "head_seq", "count", "window_days", "features_format", "days", "deltas"],
  "properties": {
    "schema_version": { "type": "integer" },
    "api": { "const": "1" },
    "generated": { "type": "integer", "description": "ms epoch of the run" },
    "generated_iso": { "type": "string", "format": "date-time" },
    "head_seq": { "type": "integer", "description": "the knowledge clock every day file and delta of this run reflects" },
    "count": { "type": "integer", "description": "live events over the days" },
    "window_days": { "type": "integer" },
    "features_format": { "type": "integer", "minimum": 1, "description": "the compact feature serialization of the day files and deltas; a client holding the window in another one re-reads every day (a format change moves no seq, so no delta carries it)" },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "path", "url", "count", "bytes", "sha256"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "path": { "type": "string" },
          "url": { "type": "string" },
          "count": { "type": "integer", "description": "live events (retired markers not counted)" },
          "bytes": { "type": "integer" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "window_seconds", "path", "url", "from_seq", "head_seq", "count", "bytes", "sha256"],
        "properties": {
          "name": { "type": "string" },
          "window_seconds": { "type": "integer" },
          "path": { "type": "string" },
          "url": { "type": "string" },
          "from_seq": { "type": "integer", "description": "exclusive: the delta holds every window event whose feed.ingest_seq is above it" },
          "head_seq": { "type": "integer" },
          "count": { "type": "integer", "description": "features, retired markers included" },
          "bytes": { "type": "integer" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
