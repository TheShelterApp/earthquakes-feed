{
  "name": "earthquakes-feed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open, free, worldwide earthquake feed — aggregated from many seismic networks, historized in Git.",
  "homepage": "https://earthquakes-feed.theshelter.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheShelterApp/earthquakes-feed.git"
  },
  "license": "CDLA-Permissive-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "aggregate": "tsx src/aggregate.ts",
    "derive": "tsx src/derive.ts",
    "backfill": "tsx src/backfill.ts",
    "archive": "tsx src/archive.ts",
    "validate": "tsx src/validate.ts",
    "replay-dedup": "tsx scripts/replay-dedup.ts",
    "heal-dryrun": "tsx scripts/heal-dryrun.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "sign-manifest": "tsx src/sign-manifest.ts",
    "publish-r2": "tsx src/publish-r2.ts"
  },
  "dependencies": {
    "@theshelter/signing": "^0.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "aws4fetch": "^1.0.20",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "4.162.0"
  }
}
