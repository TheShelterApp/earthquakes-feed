# Run markers: the tool step exits 0 so its commit step still runs, and a trailing
# `if: always()` step reds the job from these. Never commit them.
archive-blocked.txt
backfill-blocked.txt
history-blocked.txt
stats-blocked.txt
stats-out/
history-out/

# Secrets and signing material: never commit (CI holds them as secrets). Public test certificates live under tests/fixtures.
*.p8
*.p12
*.pem
*.key
!tests/fixtures/**
